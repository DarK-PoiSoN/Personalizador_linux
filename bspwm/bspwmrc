#!/bin/sh

# Cursor: el mismo tema que usan las aplicaciones GTK (o el del sistema si no
# hay ninguno elegido), para que el raton se vea igual en todas partes
cursor=$(sed -n 's/^gtk-cursor-theme-name *= *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$HOME/.config/gtk-3.0/settings.ini" 2> /dev/null | head -n 1)
[ -d "/usr/share/icons/$cursor/cursors" ] || [ -d "$HOME/.icons/$cursor/cursors" ] || cursor=default
export XCURSOR_THEME="$cursor"
export XCURSOR_SIZE=24
printf 'Xcursor.theme: %s\nXcursor.size: 24\n' "$cursor" | xrdb -merge
xsetroot -cursor_name left_ptr

# Autoarranque
if pgrep -x sxhkd > /dev/null; then
	pkill -USR1 -x sxhkd
else
	sxhkd &
fi
# Herramientas de la maquina virtual: portapapeles, arrastrar archivos y
# redimensionado de pantalla con el anfitrion (VMware / VirtualBox)
if command -v vmware-user-suid-wrapper > /dev/null && ! pgrep -f 'vmtoolsd -n vmusr' > /dev/null; then
	vmware-user-suid-wrapper &
fi
if command -v VBoxClient-all > /dev/null && ! pgrep -x VBoxClient > /dev/null; then
	VBoxClient-all &
fi
wmname LG3D &

# Compositor (picom, o compton en sistemas antiguos)
if ! pgrep -x picom > /dev/null && ! pgrep -x compton > /dev/null; then
	if command -v picom > /dev/null; then
		picom --config "$HOME/.config/picom/picom.conf" &
	elif command -v compton > /dev/null; then
		compton --config "$HOME/.config/picom/picom.conf" &
	fi
fi

# Mover las ventanas flotantes arrastrando desde su parte de arriba
pkill -f '^[^ ]*python3 [^ ]*/arrastrar_ventanas$'
"$HOME/.config/bspwm/scripts/arrastrar_ventanas" &

feh --bg-fill "$HOME/.config/personalizador/wallpaper"
bspc config pointer_modifier mod1
"$HOME/.config/polybar/launch.sh" &

for monitor in $(bspc query -M --names); do
	bspc monitor "$monitor" -d I II III IV V VI VII VIII IX X
done

# Borde fino: gris claro en la ventana con el foco, casi invisible en el resto
bspc config border_width         2
bspc config focused_border_color "#757578"
bspc config active_border_color  "#1c1f26"
bspc config normal_border_color  "#1c1f26"
bspc config presel_feedback_color "#757578"
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Caja state=floating rectangle=1000x600+100+100 follow=on
#bspc rule -a Caja state=floating follow=on
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
